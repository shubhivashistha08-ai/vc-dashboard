# Copy this file to .streamlit/secrets.toml and fill in your keys
# Do NOT commit secrets.toml to git

TWITTER_BEARER_TOKEN = "your_twitter_bearer_token_here"
YOUTUBE_API_KEY = "your_youtube_data_api_v3_key_here"
NEWS_API_KEY = "your_newsapi_org_key_here"

# Meta (Instagram + Facebook) — both free via developers.facebook.com
# Required permissions: instagram_basic, instagram_manage_insights,
#                       pages_show_list, pages_read_engagement
META_ACCESS_TOKEN = "your_long_lived_meta_user_access_token_here"
INSTAGRAM_BUSINESS_ACCOUNT_ID = "your_instagram_business_account_numeric_id_here"

# Reddit: no API key needed — uses public JSON API
